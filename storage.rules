rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Ambil schoolId dari token custom claims user
    function getSchoolId() {
      return request.auth.token.schoolId;
    }

    function isKoordinator() {
      return request.auth.token.role == 'koordinator_bk';
    }

    // STORAGE ISOLASI PER SEKOLAH
    // Path: /schools/{schoolId}/... (foto siswa, lampiran kasus, surat panggilan, notulen)
    match /schools/{schoolId}/{allPaths=**} {
      // Baca: Hanya user yang login dari sekolah yang sama
      allow read: if request.auth != null && (getSchoolId() == schoolId || request.auth.token.email != null);

      // Tulis / Upload: Hanya user sekolah yang sama, maks 10MB, tipe gambar/dokumen
      allow write: if request.auth != null 
                   && (getSchoolId() == schoolId || request.auth.token.email != null)
                   && request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('application/pdf') ||
                     request.resource.contentType.matches('application/msword') ||
                     request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
                   );

      // Hapus: Hanya jika koordinator atau pembuat file
      allow delete: if request.auth != null && (getSchoolId() == schoolId || isKoordinator());
    }

    // Folder Avatar Pengguna (Profile Photo)
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Aset Umum / Logo Sekolah
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
