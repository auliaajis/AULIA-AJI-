rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registri profil dan metadata sekolah
    match /schools_registry/{schoolId} {
      allow read, write: if true;
    }

    // Pangkalan data terisolasi per ID sekolah (Multi-Tenancy)
    match /schools/{schoolId}/{collectionName}/{docId} {
      allow read, write: if true;
    }

    // Root metadata & fallback
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

