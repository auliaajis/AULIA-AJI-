{
  "entities": {
    "schools": {
      "title": "Sekolah",
      "description": "Profil dan metadata sekolah bimbingan konseling multi-tenancy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolAddress": { "type": "string" },
        "npsn": { "type": "string" },
        "principalName": { "type": "string" },
        "principalNip": { "type": "string" },
        "koordinatorBkName": { "type": "string" },
        "koordinatorBkNip": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["schoolId", "schoolName"]
    },
    "users": {
      "title": "Pengguna / Guru BK",
      "description": "Akun dan profil guru BK sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "nip": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      },
      "required": ["schoolId", "schoolName"]
    },
    "students": {
      "title": "Data Siswa",
      "description": "Daftar data siswa bimbingan konseling dengan partisi sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nis": { "type": "string" },
        "class": { "type": "string" },
        "gender": { "type": "string" },
        "violationPoints": { "type": "number" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      },
      "required": ["schoolId", "schoolName"]
    },
    "cases": {
      "title": "Kasus & Pelanggaran Disiplin",
      "description": "Catatan kasus pelanggaran dan pembinaan restitusi disiplin siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "category": { "type": "string" },
        "pointsAdded": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "restitutionStatus": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      },
      "required": ["schoolId", "schoolName"]
    },
    "teachers": {
      "title": "Daftar Guru & Petugas Piket",
      "description": "Direktori nama guru untuk dropdown pelapor di halaman publik /piket dan menu Daftar Guru",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "schoolId": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "violations": {
      "title": "Pelanggaran & Rujukan Piket Siswa",
      "description": "Catatan rujukan piket dan pendampingan pembinaan disiplin (create publik terbatas untuk link /piket, read/update/delete hanya BK)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 120 },
        "studentClass": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 15 },
        "category": { "type": "string", "maxLength": 120 },
        "specificBehaviors": { "type": "array" },
        "reportedBy": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "piketNotes": { "type": "string", "maxLength": 1000 },
        "reportedVia": { "type": "string" },
        "source": { "type": "string" },
        "reporterRole": { "type": "string" },
        "handledBy": { "type": "string" },
        "restitutionStatus": { "type": "string" },
        "pointsAdded": { "type": "number" },
        "proofPhotoUrl": { "type": "string", "maxLength": 500000 },
        "proofPhotoName": { "type": "string", "maxLength": 150 },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "migratedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "studentName", "category", "reportedBy", "date", "time", "location", "schoolId", "schoolName"]
    },
    "counseling": {
      "title": "Layanan Konseling",
      "description": "Catatan sesi konseling dan bimbingan siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceType": { "type": "string" },
        "date": { "type": "string" },
        "problem": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      },
      "required": ["schoolId", "schoolName"]
    },
    "services": {
      "title": "Layanan BK",
      "description": "Catatan layanan bimbingan konseling siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceType": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      },
      "required": ["schoolId", "schoolName"]
    },
    "daily_journals": {
      "title": "Jurnal Harian BK",
      "description": "Jurnal harian aktivitas guru BK",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      }
    },
    "home_visits": {
      "title": "Home Visit",
      "description": "Laporan kunjungan rumah siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      }
    },
    "parent_summons": {
      "title": "Pemanggilan Orang Tua",
      "description": "Catatan surat panggilan & notulen kehadiran orang tua",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      }
    },
    "attendance_history": {
      "title": "Kehadiran Siswa",
      "description": "Rekapitulasi kehadiran harian siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      }
    },
    "student_achievements": {
      "title": "Prestasi Siswa",
      "description": "Apresiasi dan poin prestasi siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      }
    },
    "app_config": {
      "title": "Pengaturan Sekolah",
      "description": "Metadata dan konfigurasi sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "schools",
      "description": "Profil dan metadata sekolah multi-tenancy"
    },
    "/schools_registry/{schoolId}": {
      "schema": "schools",
      "description": "Registri sekolah terdaftar"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Koleksi akun pengguna guru BK"
    },
    "/teachers/{teacherId}": {
      "schema": "teachers",
      "description": "Direktori guru dan petugas piket"
    },
    "/students/{studentId}": {
      "schema": "students",
      "description": "Koleksi siswa bimbingan konseling"
    },
    "/violations/{violationId}": {
      "schema": "violations",
      "description": "Koleksi rujukan piket dan catatan pembinaan pelanggaran siswa"
    },
    "/cases/{caseId}": {
      "schema": "cases",
      "description": "Koleksi kasus pelanggaran disiplin siswa"
    },
    "/services/{serviceId}": {
      "schema": "services",
      "description": "Koleksi layanan BK siswa"
    },
    "/counseling/{counselingId}": {
      "schema": "counseling",
      "description": "Koleksi layanan konseling siswa"
    },
    "/schools/{schoolId}/counselors/{counselorId}": {
      "schema": "users",
      "description": "Akun guru BK per sekolah"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "students",
      "description": "Data siswa bimbingan konseling per sekolah"
    },
    "/schools/{schoolId}/violations/{violationId}": {
      "schema": "violations",
      "description": "Catatan pelanggaran dan rujukan piket per sekolah"
    },
    "/schools/{schoolId}/services/{serviceId}": {
      "schema": "services",
      "description": "Catatan layanan konseling per sekolah"
    }
  }
}
